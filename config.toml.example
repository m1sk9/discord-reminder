[system]
log_level = "info"
tick_interval_sec = 30
timezone = "Asia/Tokyo"

[[reminders]]
name = "daily-standup"
time = "09:30"
days = ["mon", "tue", "wed", "thu", "fri"]
message = "Daily standup starting in 5 minutes."
webhook = "team"

[[reminders]]
name = "weekly-review"
time = "17:00"
days = ["fri"]
message = "Weekly review at 18:00."
webhook = "team"
